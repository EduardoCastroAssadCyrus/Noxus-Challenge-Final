# Copie para backend/.env apenas no seu ambiente local.
NOXUS_ENVIRONMENT=development
NOXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NOXUS_DATA_FILE=.data/noxus.local.json

# Chave para POST /api/findings e /api/integrations/noxus-vscode/scans.
# Configure a mesma chave no Agent (X-API-Key). Nunca usar VITE_ para segredos.
# NOXUS_INGESTION_API_KEY=
# Sem chave explícita, agent:init gera backend/.data/agent-connection.json.
# API e launcher do Agent leem a mesma chave; ela não vai para o frontend.
NOXUS_AGENT_API_URL=http://127.0.0.1:8000
# NOXUS_AGENT_PROJECT=C:/caminho/Challenge/NOXUS-Agent-API-v2/noxus-local-v2

# O chatbot permanece separado da triagem pelo CrewAI.
NOXUS_CHAT_PROVIDER=disabled
NOXUS_CREW_PROVIDER=challenge3
NOXUS_CREW_TIMEOUT_SECONDS=600
# NOXUS_CREW_PROJECT=C:/caminho/Challenge/challenge3/challenge3

# As credenciais e modelos são lidos do .env/.env.noxus do Challenge3.
