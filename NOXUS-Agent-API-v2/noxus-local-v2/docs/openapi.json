  "components": {
    "schemas": {
      "Asset": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Name"
          },
          "type": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Type",
            "default": "web-api"
          },
          "repository_url": {
            "anyOf": [
              { "type": "string", "maxLength": 1024, "minLength": 1 },
              { "type": "null" }
            ],
            "default": null,
            "title": "Repository Url"
          },
          "branch": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Branch",
            "default": "main"
          },
          "commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit"
          },
          "local_ip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Ip"
          },
          "application_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Url"
          },
          "consumed_apis": {
            "items": {
              "$ref": "#/components/schemas/ConsumedAPI"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Consumed Apis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Asset"
      },
      "ConsumedAPI": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Name"
          },
          "base_url": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Base Url"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "detected"
            ],
            "title": "Source",
            "default": "manual"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "base_url"
        ],
        "title": "ConsumedAPI"
      },
      "Dependency": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "ecosystem": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Ecosystem"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Dependency"
      },
      "Developer": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "team": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Team"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Developer"
      },
      "Finding": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 8000,
            "title": "Description",
            "default": ""
          },
          "rule_id": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Rule Id"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "cwe": {
            "items": {
              "type": "string",
              "pattern": "^CWE-\\d+$"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Cwe"
          },
          "cve": {
            "items": {
              "type": "string",
              "pattern": "^CVE-\\d{4}-\\d{4,}$"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Cve"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "dependency": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Dependency"
              },
              {
                "type": "null"
              }
            ]
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "rule_id",
          "location"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "file": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "column": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Column"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Location"
      },
      "Scan": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "enum": [
              "semgrep",
              "gitleaks",
              "dependency-check",
              "nikto",
              "sonar",
              "dependency-reputation",
              "extension-reputation"
            ],
            "title": "Tool"
          },
          "tool_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Version"
          },
          "category": {
            "type": "string",
            "enum": [
              "SAST",
              "DAST",
              "SCA",
              "SECRET",
              "EXTENSION"
            ],
            "title": "Category"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "title": "Finished At"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed"
            ],
            "title": "Status"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "manual",
              "startup",
              "file-change",
              "dependency-change",
              "commit",
              "app-online",
              "scheduled",
              "ide-save",
              "ide-change",
              "extension-change"
            ],
            "title": "Trigger",
            "default": "manual"
          },
          "error": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "tool",
          "category",
          "started_at",
          "finished_at",
          "status"
        ],
        "title": "Scan"
      },
      "ScanEnvelope": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "source": {
            "type": "string",
            "enum": [
              "noxus-agent",
              "noxus-vscode-extension"
            ],
            "title": "Source"
          },
          "developer": {
            "$ref": "#/components/schemas/Developer"
          },
          "asset": {
